# Environment is selected by the deployment pipeline, never by client input.
APP_ENV=dev
GCP_PROJECT_ID=vl-docs-dev
MONGODB_URI=replace-with-secret-manager-reference
MONGODB_DATABASE=vl_docs_dev
IDRIVE_ENDPOINT=https://s3.example.invalid
IDRIVE_BUCKET=vl-docs-dev
IDRIVE_REGION=us-east-1
IDRIVE_ACCESS_KEY_ID=replace-with-secret-manager-reference
IDRIVE_SECRET_ACCESS_KEY=replace-with-secret-manager-reference
LOG_LEVEL=info
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-vl-docs.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-vl-docs
VITE_FIREBASE_STORAGE_BUCKET=demo-vl-docs.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=local-dev-app-id
VITE_USE_FIREBASE_EMULATORS=true
