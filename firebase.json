{
  "hosting": {
    "public": "apps/web/dist/spa",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "southamerica-east1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": { "source": "apps/functions" }
}
