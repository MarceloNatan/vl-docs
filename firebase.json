{
  "hosting": {
    "public": "apps/web/dist/spa",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "southamerica-east1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": { "source": "apps/functions" }
  ,"emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 }
  }
}
